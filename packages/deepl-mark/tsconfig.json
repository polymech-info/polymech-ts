{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"forceConsistentCasingInFileNames": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"declaration": true,
		"emitDeclarationOnly": true,
		"lib": [
			"ESNext"
		],
		"noEmit": false,
		"outDir": "./dist",
		"rootDir": "src",
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"target": "ESNext"
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"src/__test__/**"
	]
}