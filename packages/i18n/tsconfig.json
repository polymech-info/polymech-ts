{
	"extends": "../typescript-config/base.json",
	"include": [
	  "src/**/*.ts"
	],
	"files": [
	  "src/index.ts",
	  "src/lib/index.ts",
	  "src/lib/translate.ts"
	],
	"compilerOptions": {
	  "strictNullChecks": false,
	  "allowJs": true,
	  "baseUrl": ".",
	  "declarationDir": "./dist",
	  "outDir": "./dist",
	  "inlineSourceMap": true,
	  "preserveConstEnums": true,
	  "paths": {
		"@/*": [
		  "src/*"
		]
	  }
	},
  }