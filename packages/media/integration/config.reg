
[HKEY_CURRENT_USER\Software\Altap\Altap Salamander 4.0\User Menu\2]
"Item Name"="resize-80"
"Command"="osr-media"
"Arguments"="resize --minWidth=1900  --width=1980 --alt=true --logLevel=info --src=\\\"$(FullName)/**/*.+(&{IMAGES})\\\""
"Initial Directory"="$(FullPath)"
"Execute Through Shell"=dword:00000001
"Close Shell Window"=dword:00000000
"Open Shell Window"=dword:00000001
"Icon"=""
"Type"=dword:00000000
"Show In Toolbar"=dword:00000001

[HKEY_CURRENT_USER\Software\Altap\Altap Salamander 4.0\User Menu\3]
"Item Name"="to jpg"
"Command"="osr-media"
"Arguments"="convert --alt=true --logLevel=info --src=\\\"$(FullName)/**/*.+(&{IMAGES})\\\" --dst=\\\"&{SRC_DIR}/&{SRC_NAME}.jpg\\\""
"Initial Directory"="$(FullPath)"
"Execute Through Shell"=dword:00000001
"Close Shell Window"=dword:00000001
"Open Shell Window"=dword:00000001
"Icon"=""
"Type"=dword:00000000
"Show In Toolbar"=dword:00000001

[HKEY_CURRENT_USER\Software\Altap\Altap Salamander 4.0\User Menu\4]
"Item Name"="watermark"
"Command"="pm-media"
"Arguments"="watermark --alt=true --logLevel=info --src=\\\"$(FullName)/**/*.+(&{IMAGES})\\\" --dst=\\\"&{SRC_DIR}/&{SRC_NAME}_watermarked.&{SRC_EXT}\\\" --watermark=\\\"&{POLYMECH-ROOT}/nordin-ex/branding/polymech-saw-ex.svg\\\""
"Initial Directory"="$(FullPath)"
"Execute Through Shell"=dword:00000001
"Close Shell Window"=dword:00000000
"Open Shell Window"=dword:00000001
"Icon"=""
"Type"=dword:00000000
"Show In Toolbar"=dword:00000001

