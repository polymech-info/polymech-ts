{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es6",
    "noImplicitAny": false,
    "inlineSourceMap": true,
    "outDir": "./.",
    "allowJs": true,
    "rootDir": "./src",
    "lib": ["es2015", "es2016", "es2017", "dom"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "pretty": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "downlevelIteration": true,
    "all": true,
  },
  "compileOnSave": true,
  "filesGlob": [
    "./src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ],
  "files": [
    "./src/index.ts",
    "./src/main.ts",
    "src/library.ts"
  ]
}
