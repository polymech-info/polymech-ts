{
  "name": "@polymech/pm-sync",
  "version": "0.4.0",
  "description": "Package to synchronize directories and repositories",
  "license": "BSD-3-Clause",
  "type": "module",
  "typings": "dist-in/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-in/index.d.ts",
      "import": "./dist-in/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "https://git.polymech.info/polymech/mono-next"
  },
