  },
  "dependencies": {
    "@polymech/commons": "file:../commons",
    "@polymech/core": "file:../core",
    "@polymech/fs": "file:../fs",
    "@polymech/log": "file:../log",
    "archiver": "^5.3.1",
    "p-map": "^7.0.3",
    "tslog": "^3.3.3",
    "typescript": "^5.7.3",
    "yargs": "^18.0.0"
